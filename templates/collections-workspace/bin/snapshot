#!/usr/bin/env bash
# Snapshot every collection of the given owners into snapshots/.
# Writes snapshots/<owner>.json (from hf-hub.py collections) and snapshots/INDEX.md.
# Usage: bin/snapshot [owner ...]   (default: owners in .owners, one per line)
# Needs HF_TOKEN. HF_HUB_SCRIPT overrides where hf-hub.py is found.
set -euo pipefail
cd "$(dirname "$0")/.."
S="${HF_HUB_SCRIPT:-}"
if [ -z "$S" ]; then
  S=$(ls -d "$HOME"/.claude/plugins/cache/*/ai-model-research/*/scripts/hf-hub.py 2>/dev/null | sort -V | tail -1 || true)
fi
if [ -z "$S" ] || [ ! -f "$S" ]; then
  S=/tmp/hf-hub.py
  curl -fsSL https://raw.githubusercontent.com/danielrosehill/AI-Model-Research-Plugin/master/scripts/hf-hub.py -o "$S"
fi
if [ $# -gt 0 ]; then owners=("$@"); else mapfile -t owners < <(grep -v '^\s*#' .owners | sed '/^\s*$/d'); fi
for o in "${owners[@]}"; do
  python3 "$S" collections "$o" > "snapshots/$o.json.tmp" && mv "snapshots/$o.json.tmp" "snapshots/$o.json"
done
python3 - snapshots <<'PY'
import json, sys, pathlib, datetime
d = pathlib.Path(sys.argv[1]); out = [f"# Collections snapshot ({datetime.date.today()})", "",
      "Generated by bin/snapshot. Do not hand-edit.", ""]
for f in sorted(d.glob("*.json")):
    cols = json.loads(f.read_text())["collections"]
    out += [f"## {f.stem} ({len(cols)} collections)", "", "| Title | Items | Visibility | Description | Slug |", "|---|---|---|---|---|"]
    for c in sorted(cols, key=lambda c: c["title"].lower()):
        desc = (c.get("description") or "").replace("|", "/")
        out.append(f"| {c['title']} | {len(c['items'])} | {'private' if c['private'] else 'public'} | {desc} | [{c['slug']}](https://huggingface.co/collections/{c['slug']}) |")
    out.append("")
(d / "INDEX.md").write_text("\n".join(out))
PY
echo "snapshots written: ${owners[*]}"
